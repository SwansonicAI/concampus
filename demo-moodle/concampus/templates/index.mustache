{{!
    @template auth_concampus/index

    The demo's way in (index.php): its access code, then its people, laid out as Moodle's login form (core/loginform).
}}
<div class="loginform">
    {{#logourl}}
        <div id="loginlogo" class="login-logo">
            <img id="logoimage" src="{{logourl}}" class="img-fluid" alt="{{sitename}}"/>
            <h1 class="login-heading sr-only">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>
        </div>
    {{/logourl}}
    {{^logourl}}
        <h1 class="login-heading mb-4">{{#str}} loginto, core, {{sitename}} {{/str}}</h1>
    {{/logourl}}
    {{#error}}
        <div class="alert alert-danger" role="alert">{{error}}</div>
    {{/error}}
    {{^admitted}}
        <h2 class="login-heading">{{#str}} access, auth_concampus {{/str}}</h2>
        <p>{{#str}} accessinfo, auth_concampus {{/str}}</p>
        <form class="login-form" action="{{url}}" method="post">
            <div class="login-form-username mb-3">
                <label for="code" class="sr-only">{{#str}} code, auth_concampus {{/str}}</label>
                <input type="password" name="code" id="code" class="form-control form-control-lg" placeholder="{{#cleanstr}} code, auth_concampus {{/cleanstr}}" autocomplete="current-password" required autofocus>
            </div>
            <div class="login-form-submit mb-3">
                <button class="btn btn-primary btn-lg" type="submit">{{#str}} continue {{/str}}</button>
            </div>
        </form>
    {{/admitted}}
    {{#admitted}}
        <h2 class="login-heading">{{#str}} choose, auth_concampus {{/str}}</h2>
        <p>{{#str}} chooseinfo, auth_concampus {{/str}}</p>
        {{#groups}}
            <form action="{{url}}" method="post" class="mb-3">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#many}}
                    <label for="{{id}}" class="font-weight-bold mb-1">{{label}}</label>
                    <div class="d-flex">
                        <select name="konto" id="{{id}}" class="custom-select">
                            {{#people}}<option value="{{username}}">{{name}}{{#detail}} · {{detail}}{{/detail}}</option>{{/people}}
                        </select>
                        <button class="btn btn-primary ml-2" type="submit">{{#str}} open, auth_concampus {{/str}}</button>
                    </div>
                {{/many}}
                {{^many}}
                    {{#first}}
                        <button class="btn btn-secondary btn-block text-left" type="submit" name="konto" value="{{username}}"><span class="font-weight-bold">{{label}}</span> <span class="text-muted">{{name}}</span></button>
                    {{/first}}
                {{/many}}
            </form>
        {{/groups}}
    {{/admitted}}
</div>
