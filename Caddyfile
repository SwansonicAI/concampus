{$DOMAIN} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy app:8000
}

# The product home page: github.com/SwansonicAI/concampus-home, cloned to /opt/concampus-home
concampus.de {
	encode zstd gzip
	root * /srv/site
	file_server
}

# The demo's Moodle: demo-moodle/, docs/moodle.md
moodle.concampus.de {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy moodle:80
}

www.concampus.de {
	redir https://concampus.de{uri} permanent
}
